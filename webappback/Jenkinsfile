pipeline {
    agent any

    environment {
        // 로컬에서만 사용할 이미지 이름 (도커 허브 ID 불필요!)
        DOCKER_IMAGE_NAME = 'my-backend-app'
        CONTAINER_BLUE = 'backend-blue'
        CONTAINER_GREEN = 'backend-green'
    }

    stages {
        // 1. 깃허브 소스코드 가져오기
        stage('Clone Git') {
            steps {
                git branch: 'master', url: 'https://github.com/ldj8196/reactWebAppBE.git'
            }
        }

        // 2. Gradle 빌드 (jar 파일 생성) - webappback 폴더 안으로 이동해서 실행
        stage('Build Gradle') {
            steps {
                dir('webappback') {
                    sh 'bash ./gradlew clean bootJar'
                }
            }
        }

        // 3. 우분투 로컬에 Docker 이미지 빌드 - 폴더 안에서 도커파일 참조
        stage('Build Docker Image') {
            steps {
                script {
                    dir('webappback') {
                        // 빌드 번호를 태그로 사용하여 로컬에 이미지 생성
                        sh "docker build -f backend.dockerfile -t ${DOCKER_IMAGE_NAME}:${env.BUILD_NUMBER} ."
                    }
                }
            }
        }

        // 4. 블루-그린 무중단 배포 및 Nginx 트래픽 전환 실행
        stage('Blue-Green Deploy') {
            steps {
                script {
                    def activeEnv = sh(script: "docker ps -a --format '{{.Names}}' | grep -E '${CONTAINER_BLUE}|${CONTAINER_GREEN}' || echo 'none'", returnStdout: true).trim()
                    
                    def targetContainer = ""
                    def oldContainer = ""
                    def targetPort = ""

                    if (activeEnv.contains(CONTAINER_GREEN)) {
                        targetContainer = CONTAINER_BLUE
                        oldContainer = CONTAINER_GREEN
                        targetPort = "8081"
                    } else {
                        targetContainer = CONTAINER_GREEN
                        oldContainer = CONTAINER_BLUE
                        targetPort = "8082"
                    }

                    echo ">>> [Deploy] 현재 구동 중인 컨테이너 교체 시작: ${oldContainer} -> ${targetContainer} (Port: ${targetPort})"

                    // 1. 새 컨테이너 실행
                    sh "docker run -d --name ${targetContainer} -p ${targetPort}:8080 ${DOCKER_IMAGE_NAME}:${env.BUILD_NUMBER}"

                    // 2. 새 컨테이너 안정화 대기 (헬스체크 대용)
                    sleep 15

                    // 3. Nginx가 바라보는 포트를 새 컨테이너의 포트로 변경 (service-url.inc 업데이트)
                    echo ">>> [Deploy] Nginx 트래픽 전환 중 (Port: ${targetPort})"
                    sh "sudo sh -c \"echo 'set \\\$service_url http://127.0.0.1:${targetPort};' > /etc/nginx/conf.d/service-url.inc\""

                    // 4. Nginx 부드러운 재시작 (무중단 트래픽 전환)
                    sh "sudo nginx -s reload"

                    // 5. 구버전 컨테이너 종료 및 삭제
                    sh "docker stop ${oldContainer} || true"
                    sh "docker rm ${oldContainer} || true"

                    echo ">>> [Deploy] 블루-그린 무중단 배포 최종 완료! (${targetContainer} 구동 중)"
                }
            }
        }
    }

    post {
        success {
            echo '🎉 파이프라인 빌드 및 배포 성공!'
        }
        failure {
            echo '❌ 파이프라인 빌드 실패...'
        }
    }
}